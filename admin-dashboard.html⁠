<!DOCTYPE html>
<html lang="bn" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>লগে আছি.com - অ্যাডমিন ড্যাশবোর্ড</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Firebase Core & Firestore CDN -->
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-firestore-compat.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">

    <!-- Navbar -->
    <nav class="bg-gray-900 text-white p-4 shadow-md flex justify-between items-center">
        <h1 class="text-xl font-bold text-orange-500">লগে আছি.com ড্যাশবোর্ড</h1>
        <button onclick="logoutAdmin()" class="bg-red-600 px-4 py-2 rounded text-sm font-semibold hover:bg-red-700 transition">লগআউট</button>
    </nav>

    <!-- Main Content -->
    <div class="max-w-3xl mx-auto p-6 mt-8">
        <!-- Product Upload Form -->
        <div class="bg-white p-6 rounded-xl shadow-md border border-gray-200">
            <h2 class="text-xl font-bold mb-4 text-gray-800">নতুন প্রোডাক্ট যোগ করুন</h2>
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">প্রোডাক্টের নাম</label>
                <input type="text" id="productName" placeholder="যেমন: প্রিমিয়াম টি-শার্ট" class="w-full p-3 border rounded-lg focus:outline-none focus:border-orange-500">
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">দাম (টাকা)</label>
                <input type="number" id="productPrice" placeholder="যেমন: ৫০০" class="w-full p-3 border rounded-lg focus:outline-none focus:border-orange-500">
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">ছবির লিংক (Image URL)</label>
                <input type="text" id="productImage" placeholder="ছবির ডাইরেক্ট লিংক দিন" class="w-full p-3 border rounded-lg focus:outline-none focus:border-orange-500">
            </div>

            <button onclick="uploadProduct()" class="w-full bg-orange-500 hover:bg-orange-600 text-white p-3 rounded-lg font-bold transition">প্রোডাক্ট আপলোড করুন</button>
            <p id="uploadMsg" class="text-center text-sm mt-3 font-medium"></p>
        </div>
    </div>

    <!-- Script -->
    <script>
      const firebaseConfig = {
        apiKey: "AIzaSyBS9G_13sh@JHthzocADDTMvVqk",
        authDomain: "logeachidotcom-f4e1e.firebaseapp.com",
        projectId: "logeachidotcom-f4e1e",
        storageBucket: "logeachidotcom-f4e1e.firebasestorage.app",
        messagingSenderId: "1060734330563",
        appId: "1:1060734330563:web:94ef66dabe99a",
        measurementId: "G-N7QJZ923L8"
      };

      firebase.initializeApp(firebaseConfig);
      const auth = firebase.auth();
      const db = firebase.firestore();

      // Check if admin is logged in
      auth.onAuthStateChanged((user) => {
        if (!user) {
          // যদি লগইন করা না থাকে, তবে লগইন পেজে পাঠিয়ে দেবে
          window.location.href = "admin-login.html";
        }
      });

      // Upload Product Function
      function uploadProduct() {
        const name = document.getElementById('productName').value;
        const price = document.getElementById('productPrice').value;
        const image = document.getElementById('productImage').value;
        const msg = document.getElementById('uploadMsg');

        if(!name || !price || !image) {
            msg.style.color = "red";
            msg.innerText = "সবগুলো ঘর পূরণ করুন!";
            return;
        }

        db.collection("products").add({
            name: name,
            price: Number(price),
            image: image,
            createdAt: firebase.firestore.FieldValue.serverTimestamp()
        })
        .then(() => {
            msg.style.color = "green";
            msg.innerText = "প্রোডাক্ট সফলভাবে আপলোড হয়েছে!";
            document.getElementById('productName').value = '';
            document.getElementById('productPrice').value = '';
            document.getElementById('productImage').value = '';
        })
        .catch((error) => {
            msg.style.color = "red";
            msg.innerText = "ত্রুটি ঘটেছে: " + error.message;
        });
      }

      // Logout Function
      function logoutAdmin() {
        auth.signOut().then(() => {
          window.location.href = "admin-login.html";
        });
      }
    </script>
</body>
</html>
